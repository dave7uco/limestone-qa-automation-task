              "                pm.expect(post[property]).to.not.be.null;",
              "                pm.expect(post[property]).to.not.be.undefined;",
              "                pm.expect(post[property]).to.not.eql(\"\");",
              "            });",
              "        });",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
